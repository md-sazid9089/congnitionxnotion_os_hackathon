# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Required. Internal integration secret from https://www.notion.so/profile/integrations
# Share your Student OS page with the integration (page menu -> Connections).
NOTION_TOKEN=

# Optional. Database IDs or full Notion URLs. When left empty, CampusCatch looks for
# shared databases whose names contain "assignment", "task" and "course".
NOTION_ASSIGNMENTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_COURSES_DB_ID=

# Optional. Override which Notion property holds each field, as JSON.
# Fields: title, dueDate, status, category, course, description, source
# NOTION_PROPERTY_MAP={"assignments":{"dueDate":"Due Date"},"tasks":{"status":"Status"}}
NOTION_PROPERTY_MAP=

# Optional. Any OpenAI-compatible API improves extraction of free-form messages.
# Without it CampusCatch uses its built-in keyword and date parser.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
